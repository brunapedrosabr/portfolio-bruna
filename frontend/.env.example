# Na Vercel: Project Settings > Environment Variables.

# URL da API Spring Boot (termina em /api). Localmente: http://localhost:8080/api
VITE_API_URL=http://localhost:8080/api

# EmailJS (https://dashboard.emailjs.com/)
VITE_EMAILJS_SERVICE_ID=seu_service_id_aqui
VITE_EMAILJS_TEMPLATE_ID_FOR_ME=seu_template_id_for_me_aqui
VITE_EMAILJS_TEMPLATE_ID_FOR_SENDER=
VITE_EMAILJS_PUBLIC_KEY=sua_public_key_aqui
