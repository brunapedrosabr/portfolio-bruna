# Variáveis do back-end (configure no painel do Render, em Environment).
# Sem elas, a API roda localmente com o banco H2 em memória.

# Conexão com o Supabase (Project Settings > Database > Connection string > JDBC, "Session pooler")
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.seu_project_ref
SPRING_DATASOURCE_PASSWORD=sua_senha_do_banco

# Endereços do front-end que podem chamar a API (separados por vírgula)
CORS_ALLOWED_ORIGINS=https://seu-portfolio.vercel.app,http://localhost:5173

# Chave para listar as mensagens recebidas: GET /api/contatos com o cabeçalho X-Admin-Key
ADMIN_KEY=troque-por-uma-chave-longa-e-secreta
